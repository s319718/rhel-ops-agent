  "blocked_patterns": [
    {
      "id": "blocked_delete_root",
      "title_zh": "删除系统根目录",
      "title_en": "Delete the filesystem root",
      "severity": "critical",
      "patterns": [
        "\\brm\\s+-[A-Za-z]*r[A-Za-z]*f?[A-Za-z]*\\s+/(?:\\s|$|\\*)",
        "\\brm\\s+-[A-Za-z]*f[A-Za-z]*r[A-Za-z]*\\s+/(?:\\s|$|\\*)"
      ],
      "reason_zh": "根目录删除会立即破坏整个系统，Agent 不允许执行。",
      "reason_en": "Deleting the filesystem root would destroy the host."
    },
    {
      "id": "blocked_disk_wipe",
      "title_zh": "格式化或覆写磁盘",
      "title_en": "Format or overwrite a block device",
      "severity": "critical",
      "patterns": [
        "\\bmkfs(?:\\.[A-Za-z0-9]+)?\\s+",
        "\\bdd\\s+.*\\bof=/dev/(?:sd|nvme|vd|hd|mapper)",
        "\\bwipefs\\s+-[A-Za-z]*a"
      ],
      "reason_zh": "该操作会破坏文件系统或块设备数据，Agent 不允许执行。",
      "reason_en": "This operation can destroy filesystem or block-device data."
    },
    {
      "id": "blocked_fork_bomb",
      "title_zh": "进程炸弹",
      "title_en": "Fork bomb",
      "severity": "critical",
      "patterns": [
        ":\\s*\\(\\s*\\)\\s*\\{\\s*:\\s*\\|\\s*:\\s*&\\s*\\}\\s*;\\s*:"
      ],
      "reason_zh": "该模式会耗尽进程资源并拖垮主机。",
      "reason_en": "This pattern exhausts process resources."
    },
    {
      "id": "blocked_disable_selinux",
      "title_zh": "关闭 SELinux",
      "title_en": "Disable SELinux",
      "severity": "high",
      "patterns": [
        "\\bsetenforce\\s+0\\b",
        "\\bselinux=disabled\\b",
        "\\bSELINUX\\s*=\\s*disabled\\b"
      ],
      "reason_zh": "降低主机安全边界不属于受支持的自动操作，请使用受控变更流程。",
      "reason_en": "Disabling SELinux is not an allowed automated operation."
    },
    {
      "id": "blocked_flush_firewall",
      "title_zh": "清空防火墙规则",
      "title_en": "Flush firewall rules",
      "severity": "high",
      "patterns": [
        "\\biptables\\s+-F\\b",
        "\\bnft\\s+flush\\s+ruleset\\b",
        "\\bfirewall-cmd\\s+--panic-on\\b"
      ],
      "reason_zh": "清空或隔离防火墙会扩大攻击面，Agent 不允许自动执行。",
      "reason_en": "Flushing the firewall can expose services unexpectedly."
    },
    {
      "id": "blocked_pipe_shell",
      "title_zh": "从网络直接执行脚本",
      "title_en": "Pipe a remote script into a shell",
      "severity": "high",
      "patterns": [
        "\\b(?:curl|wget)\\b[^\\n|]*\\|\\s*(?:ba|z|k)?sh\\b",
        "\\b(?:curl|wget)\\b[^\\n|]*\\|\\s*python[0-9.]*\\b"
      ],
      "reason_zh": "远程内容未经校验直接执行，来源和内容都无法确认。",
      "reason_en": "Remote content would be executed without verification."
    },
    {
      "id": "blocked_crontab_clear",
      "title_zh": "清空计划任务",
      "title_en": "Remove all scheduled jobs",
      "severity": "high",
      "patterns": [
        "\\bcrontab\\s+-r\\b",
        "\\brm\\s+-[A-Za-z]*rf?\\s+/var/spool/cron\\b"
      ],
      "reason_zh": "清空计划任务可能破坏备份、监控和业务作业。",
      "reason_en": "Removing all scheduled jobs can break backup and monitoring."
    }
  ]
