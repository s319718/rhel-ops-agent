# Keep the privileged web console on loopback and use an SSH tunnel.
RHEL_OPS_HOST=127.0.0.1
RHEL_OPS_PORT=8765
RHEL_OPS_DATA_DIR=/var/lib/rhel-ops-agent
RHEL_OPS_AUDIT_POLL=20
RHEL_OPS_SCAN_TIMEOUT=20
RHEL_OPS_PROPOSAL_TTL=900
RHEL_OPS_HISTORY_LINES=3000

# Leave unset in production so the installer generates a random password.
# RHEL_OPS_ADMIN_PASSWORD=change-this-before-first-start
