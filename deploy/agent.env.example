# Keep the privileged web console on loopback and use an SSH tunnel.
RHEL_OPS_HOST=127.0.0.1
RHEL_OPS_PORT=8765
RHEL_OPS_DATA_DIR=/var/lib/rhel-ops-agent
RHEL_OPS_AUDIT_POLL=20
RHEL_OPS_SCAN_TIMEOUT=20
RHEL_OPS_PROPOSAL_TTL=900
RHEL_OPS_HISTORY_LINES=3000

# Optional LLM intent understanding. Rules and hard blocks stay authoritative.
# RHEL_OPS_LLM_ENABLED=1
# RHEL_OPS_LLM_MODE=llm_first
#
# Zhipu GLM (recommended):
# RHEL_OPS_LLM_PROVIDER=openai-compatible
# RHEL_OPS_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# RHEL_OPS_LLM_MODEL=glm-4-plus
# RHEL_OPS_LLM_API_KEY=replace-with-a-secret
# RHEL_OPS_LLM_TIMEOUT=40
# RHEL_OPS_LLM_STRUCTURED_OUTPUT=0
#
# Alibaba Cloud DashScope / Qwen API:
# RHEL_OPS_LLM_PROVIDER=qwen
# RHEL_OPS_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# RHEL_OPS_LLM_MODEL=qwen-plus
# RHEL_OPS_LLM_API_KEY=replace-with-a-secret
#
# Local Ollama:
# RHEL_OPS_LLM_PROVIDER=ollama
# RHEL_OPS_LLM_BASE_URL=http://127.0.0.1:11434
# RHEL_OPS_LLM_MODEL=qwen2.5:7b-instruct
# RHEL_OPS_LLM_TIMEOUT=20
# RHEL_OPS_LLM_CONFIDENCE=0.55
# RHEL_OPS_LLM_STRUCTURED_OUTPUT=1
# RHEL_OPS_LLM_MAX_ACTIONS=6

# Other OpenAI-compatible services:
# RHEL_OPS_LLM_PROVIDER=openai-compatible
# RHEL_OPS_LLM_BASE_URL=https://your-provider.example/v1
# RHEL_OPS_LLM_MODEL=your-tool-calling-model
# RHEL_OPS_LLM_API_KEY=replace-with-a-secret

# Leave unset in production so the installer generates a random password.
# RHEL_OPS_ADMIN_PASSWORD=change-this-before-first-start
